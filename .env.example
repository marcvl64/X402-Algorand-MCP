# Transport: "http" (remote, default) or "stdio" (local dev)
MCP_TRANSPORT=http
PORT=3000

# Facilitator that verifies/settles payments and serves the discovery catalog.
# GoPlausible is the Algorand facilitator; its /discovery/* API backs every
# discovery tool in this server.
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz

# Default Algorand network in CAIP-2 form. Note these are standard base64
# genesis hashes: they contain "/" and a trailing "=", not the URL-safe variant.
# MainNet: algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=
# TestNet: algorand:SGO1GKSzyE7IEPItTxCByw9x8FmnrCDexi9/cOUJOiI=
X402_DEFAULT_NETWORK=algorand:wGHE2Pwdvd7S12BL5FaOP20EGYesN73ktiC1qzkkit8=

# Algod endpoint used to build payment transaction groups.
# Must match X402_DEFAULT_NETWORK.
ALGOD_URL=https://mainnet-api.algonode.cloud
ALGOD_TOKEN=

# Spend guardrails, enforced server-side on every payment.
# Amounts are in the asset's atomic units.
X402_MAX_AMOUNT_ATOMIC=1000000
# Comma-separated ASA IDs; empty means "any asset".
X402_ALLOWED_ASSETS=

# How long a prepared payment may sit awaiting signatures, from any signer.
X402_PENDING_TTL_MS=300000

# --- Abuse resistance (public instances) -----------------------------------
# Max payments one session may hold awaiting signature. Each parked payment
# holds an open upstream connection.
X402_MAX_PENDING_PAYMENTS=16
# Timeout for outbound calls to merchant endpoints.
X402_UPSTREAM_TIMEOUT_MS=30000
X402_MAX_REDIRECTS=3
# Max concurrent MCP sessions before new ones are refused.
MCP_MAX_SESSIONS=256
# Allow outbound requests into private address space. DEVELOPMENT ONLY — on a
# public instance this turns the server into an SSRF pivot into your network.
X402_ALLOW_PRIVATE_EGRESS=false
